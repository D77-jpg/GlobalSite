# Local development; independent database only.
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27018/globalsite?directConnection=true
PUBLIC_URL=http://localhost:5173
STORAGE_ROOT=storage
# Base64-encoded 32 random bytes; blank generates a shared local development key.
CREDENTIAL_ENCRYPTION_KEY=
# Optional SMTP: blank uses development browser previews and redacted log metadata.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GlobalSite <noreply@example.invalid>

# Compose port; when using Compose set PUBLIC_URL=http://localhost:5080.
API_PORT=5080

# Optional test process variables (export in shell when overriding defaults):
# E2E_BASE_URL=http://localhost:5080
# MONGOMS_VERSION=7.0.14
# MONGOMS_SYSTEM_BINARY=

# Optional: explicit trusted reverse-proxy IP/CIDR list for inquiry gateway only. Blank ignores forwarded IP headers.
INQUIRY_TRUSTED_PROXY=

# Optional GlobalCRM connection; explicit exact origins. Blank leaves standalone mode fully available.
CRM_ALLOWED_ORIGINS=
# Non-production loopback demonstration only; ignored in production.
CRM_ALLOW_LOCAL=false
