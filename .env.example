# Local development; independent database only.
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27018/globalsite?directConnection=true
PUBLIC_URL=http://localhost:5173
STORAGE_ROOT=storage
# Optional S3/R2 object storage adapter: local (default) or s3.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
# Base64-encoded 32 random bytes; blank generates a shared local development key.
CREDENTIAL_ENCRYPTION_KEY=
# Optional SMTP: blank uses development browser previews and redacted log metadata.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GlobalSite <noreply@example.invalid>

# Compose port; when using Compose set PUBLIC_URL=http://localhost:5080.
API_PORT=5080

# Optional test process variables (export in shell when overriding defaults):
# E2E_BASE_URL=http://localhost:5080
# MONGOMS_VERSION=7.0.14
# MONGOMS_SYSTEM_BINARY=

# Optional: explicit trusted reverse-proxy IP/CIDR list for inquiry gateway only. Blank ignores forwarded IP headers.
INQUIRY_TRUSTED_PROXY=

# Optional GlobalCRM connection; explicit exact origins. Blank leaves standalone mode fully available.
CRM_ALLOWED_ORIGINS=
# Non-production loopback demonstration only; ignored in production.
CRM_ALLOW_LOCAL=false

# Exact optional local AI relay; non-production only.
AI_LOCAL_BASE_URL=
# Optional comma-separated HTTPS host allowlist for AI/image providers. Blank allows any SSRF-verified public HTTPS host.
AI_ALLOWED_HOSTS=
# Worker concurrent lanes: fast (mail, inquiry, crm) and heavy (site agent, builds, deployments, catalog).
WORKER_FAST_CONCURRENCY=2
WORKER_HEAVY_CONCURRENCY=2

# Optional for a Node worker outside Docker; Docker ships Chromium in /ms-playwright.
# PLAYWRIGHT_BROWSERS_PATH=/path/to/installed/ms-playwright

# S35 AI illustration caps per generated page (0-12). Used only for sites with autoImages on
# and a configured organization image service; same-slot images are reused, never regenerated.
AUTO_IMAGE_HOME_MAX=6
AUTO_IMAGE_DETAIL_MAX=3
# S37 bounded parallel image generation concurrency per page unit (1-4, default 2).
AUTO_IMAGE_CONCURRENCY=2
# S35 quality-review baseline: total score (1-5) below this adds "refine from review" advice.
QUALITY_BASELINE_THRESHOLD=3.5
# S37 site review sampling threshold (default 4; 0 disables sampling). Above this page count,
# full AI review runs on home + first representative page per type; sibling pages get structural + browser review.
REVIEW_SAMPLE_THRESHOLD=4
# S35 long AI tasks (design/content/refine and quality review): total wait in ms, 120000-600000.
AI_FULL_PAGE_TIMEOUT_MS=240000
# S37 SSE streaming for long AI tasks (true by default; set false for non-streaming providers).
AI_STREAM_LONG_TASKS=true
# S35 unknown AI outcomes (timeout, network, missing usage) are absorbed by the platform:
# the organization is not charged and the step retries. Automatic absorptions per
# organization and month (0-1000); above it the job pauses until the user retries.
AI_UNKNOWN_ABSORB_LIMIT=5

# S36 platform AI service (production: inject through a secret manager; never commit real keys).
# When PLATFORM_AI_BASE_URL + PLATFORM_AI_API_KEY + PLATFORM_AI_MODEL are all set, every
# organization uses the platform text service and the AI settings page becomes read-only.
# Otherwise non-production falls back to each organization's own AI settings.
PLATFORM_AI_BASE_URL=
PLATFORM_AI_API_KEY=
PLATFORM_AI_MODEL=
# Optional vision model; setting it enables screenshot/image input for platform AI.
PLATFORM_AI_VISION_MODEL=
# Optional: json_object (default) or json_schema.
PLATFORM_AI_OUTPUT_MODE=
# Platform image service (all three required), mode auto (default) | images | chat.
PLATFORM_IMAGE_BASE_URL=
PLATFORM_IMAGE_API_KEY=
PLATFORM_IMAGE_MODEL=
PLATFORM_IMAGE_MODE=auto
# Keep organization-provided keys usable in production (default false; not offered to customers).
ALLOW_ORG_AI_KEYS=false
# Optional https: or mailto: link for "Upgrade plan"; blank shows "contact us to upgrade".
PLATFORM_UPGRADE_URL=
# Optional ops:usage cost estimate inputs: price per 1,000,000 AI units, price per image,
# and a monthly total-cost alert threshold (same currency). Blank skips the estimate/alert.
PLATFORM_AI_PRICE_PER_MILLION=
PLATFORM_IMAGE_PRICE=
PLATFORM_COST_ALERT=
