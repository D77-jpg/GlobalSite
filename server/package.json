{
  "name": "@globalsite/server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.24.0",
    "zod": "^4.1.0",
    "bcryptjs": "^3.0.2",
    "nodemailer": "^10.3.1",
    "helmet": "^8.1.0",
    "dotenv": "^16.6.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^7.0.0",
    "@types/multer": "^2.0.0",
    "mongodb-memory-server": "^11.0.0",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
